				is_navigable 	TRUE
				Containment 	"By Value")))
		    (object Association "Document_has_Correspondent"
			quid       	"RL000002"
			documentation 	"Документ связан с корреспондентом (отправитель или получатель)."
			roles      	(list role_list
			    (object Role "$UNNAMED$20"
				quid       	"RL000002A"
