	    (object UseCase "UC1: Регистрация документа"
		quid       	"UC000001"
		exportControl 	"Public"
		documentation 	"Регистрация входящей, исходящей или внутренней деловой документации в системе. Включает заполнение метаданных документа, выбор корреспондента, назначение задач и исполнителей.")
	    (object UseCase "UC2: Изменение поручения"
		quid       	"UC000002"
		exportControl 	"Public"
		documentation 	"Внесение изменений в ходе исполнения поручений: перенос сроков исполнения, назначение новых исполнителей.")
	    (object UseCase "UC2.1: Перенос срока исполнения"
		quid       	"UC000003"
		exportControl 	"Public"
		documentation 	"Изменение даты крайнего срока исполнения задачи.")
	    (object UseCase "UC2.2: Назначение нового исполнителя"
		quid       	"UC000004"
		exportControl 	"Public"
		documentation 	"Переназначение задачи другому сотруднику предприятия.")
	    (object UseCase "UC3: Отчёт по просроченным документам"
		quid       	"UC000005"
		exportControl 	"Public"
		documentation 	"На заданную дату формируется список документов (номер, название, тип), у которых истекли сроки выполнения задач.")
	    (object UseCase "UC4: Уведомления о приближающихся сроках"
		quid       	"UC000006"
		exportControl 	"Public"
		documentation 	"Выдача уведомлений на заданную дату о приближающихся сроках исполнения задач (тех, у которых дата исполнения более заданной на определённое количество дней). Указываются: номер документа, название документа, название задачи, ФИО и должность исполнителя.")
	    (object UseCase "UC5: Управление корреспондентами"
		quid       	"UC000007"
		exportControl 	"Public"
		documentation 	"Добавление и редактирование корреспондентов: внутренних (отдел, должностное лицо) и внешних (код, название организации).")
	    (object UseCase "UC6: Управление сотрудниками"
		quid       	"UC000008"
		exportControl 	"Public"
		documentation 	"Добавление и редактирование информации о сотрудниках предприятия: ФИО, должность, телефон, электронный адрес.")
