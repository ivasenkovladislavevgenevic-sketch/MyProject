    root_category 	(object Class_Category "Logical View"
	quid       	"00000003"
	exportControl 	"Public"
	global     	TRUE
	logical_models 	(list unit_reference_list
	    (object Class_Category "Domain Model"
		quid       	"PKG00001"
		exportControl 	"Public"
		logical_models 	(list unit_reference_list
		    (object Class "Employee"
			quid       	"CL000001"
			documentation 	"Сотрудник предприятия. Выступает в ролях: исполнитель задач, автор резолюций, контролёр исполнения документов. Хранит ФИО, должность, телефон и электронный адрес."
			exportControl 	"Public"
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "id"
				quid       	"AT000001"
				type       	"Integer"
				exportControl 	"Public"
				Containment 	"By Value"
				stereotype 	"PK")
			    (object ClassAttribute "full_name"
				quid       	"AT000002"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "position"
				quid       	"AT000003"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "phone"
				quid       	"AT000004"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "email"
				quid       	"AT000005"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")))
		    (object Class "Correspondent"
			quid       	"CL000002"
			documentation 	"Корреспондент документа. Может быть внутренним (отдел, должностное лицо) или внешним (код, название организации)."
			exportControl 	"Public"
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "id"
				quid       	"AT000010"
				type       	"Integer"
				exportControl 	"Public"
				Containment 	"By Value"
				stereotype 	"PK")
			    (object ClassAttribute "type"
				quid       	"AT000011"
				type       	"CorrespondentType"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "department"
				quid       	"AT000012"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "official_name"
				quid       	"AT000013"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "code"
				quid       	"AT000014"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "organization_name"
				quid       	"AT000015"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")))
		    (object Class "Document"
			quid       	"CL000003"
			documentation 	"Деловой документ (входящий, исходящий, внутренний). Фиксируется номер и дата создания документа, дата его регистрации. Содержит задачи с привязкой к исполнителям."
			exportControl 	"Public"
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "id"
				quid       	"AT000020"
				type       	"Integer"
				exportControl 	"Public"
				Containment 	"By Value"
				stereotype 	"PK")
			    (object ClassAttribute "number"
				quid       	"AT000021"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "name"
				quid       	"AT000022"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "document_type"
				quid       	"AT000023"
				type       	"DocumentType"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "creation_date"
				quid       	"AT000024"
				type       	"Date"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "registration_date"
				quid       	"AT000025"
				type       	"Date"
				exportControl 	"Public"
				Containment 	"By Value"))
			operations 	(list Operations
			    (object Operation "register"
				quid       	"OP000001"
				result     	"void"
				exportControl 	"Public"
				documentation 	"Регистрация документа в системе")
			    (object Operation "get_overdue_tasks"
				quid       	"OP000002"
				parameters 	(list Parameters
				    (object Parameter "date"
					type       	"Date"))
				result     	"List"
				exportControl 	"Public"
				documentation 	"Получить список просроченных задач на указанную дату")))
		    (object Class "Task"
			quid       	"CL000004"
			documentation 	"Задача документа. Каждая задача имеет код, название и срок исполнения. За каждой задачей в конкретном документе закреплён один исполнитель. Каждый исполнитель может отвечать за несколько задач."
			exportControl 	"Public"
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "id"
				quid       	"AT000030"
				type       	"Integer"
				exportControl 	"Public"
				Containment 	"By Value"
				stereotype 	"PK")
			    (object ClassAttribute "code"
				quid       	"AT000031"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "name"
				quid       	"AT000032"
				type       	"String"
				exportControl 	"Public"
				Containment 	"By Value")
			    (object ClassAttribute "deadline"
				quid       	"AT000033"
				type       	"Date"
				exportControl 	"Public"
				Containment 	"By Value"))
			operations 	(list Operations
			    (object Operation "is_overdue"
				quid       	"OP000003"
				parameters 	(list Parameters
				    (object Parameter "date"
					type       	"Date"))
				result     	"Boolean"
				exportControl 	"Public"
				documentation 	"Проверить, просрочена ли задача на указанную дату")
			    (object Operation "reschedule"
				quid       	"OP000004"
				parameters 	(list Parameters
				    (object Parameter "new_date"
					type       	"Date"))
				result     	"void"
				exportControl 	"Public"
				documentation 	"Перенести срок исполнения задачи")
			    (object Operation "reassign"
				quid       	"OP000005"
				parameters 	(list Parameters
				    (object Parameter "executor"
					type       	"Employee"))
				result     	"void"
				exportControl 	"Public"
				documentation 	"Назначить нового исполнителя")))
		    (object Class "DocumentType"
			quid       	"CL000005"
			stereotype 	"enumeration"
			exportControl 	"Public"
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "INCOMING"
				quid       	"AT000040"
				exportControl 	"Public")
			    (object ClassAttribute "OUTGOING"
				quid       	"AT000041"
				exportControl 	"Public")
			    (object ClassAttribute "INTERNAL"
				quid       	"AT000042"
				exportControl 	"Public")))
		    (object Class "CorrespondentType"
			quid       	"CL000006"
			stereotype 	"enumeration"
			exportControl 	"Public"
			class_attributes 	(list class_attribute_list
			    (object ClassAttribute "INTERNAL"
				quid       	"AT000050"
				exportControl 	"Public")
			    (object ClassAttribute "EXTERNAL"
				quid       	"AT000051"
				exportControl 	"Public")))
		    (object Association "Document_contains_Tasks"
			quid       	"RL000001"
			documentation 	"Документ содержит задачи (композиция). При удалении документа удаляются все его задачи."
			roles      	(list role_list
			    (object Role "document"
				quid       	"RL000001A"
				label      	"document"
				supplier   	"Logical View::Domain Model::Document"
				quidu      	"CL000003"
				client_cardinality 	(value cardinality "1")
