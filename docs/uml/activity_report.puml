@startuml "Activity Diagram - Формирование отчётов"

start

:Выбор типа отчёта;

switch (Тип отчёта?)
case (Просроченные документы)
    :Ввод контрольной даты;
    :Запрос к БД: документы с задачами,\nу которых deadline < дата;
    :Формирование списка;
    :Отображение таблицы:\n- Номер документа\n- Название документа\n- Тип документа;

case (Приближающиеся сроки)
    :Ввод контрольной даты;
    :Ввод количества дней (N);
    :Запрос к БД: задачи,\nу которых дата <= deadline <= дата + N;
    :Формирование списка;
    :Отображение таблицы:\n- Номер документа\n- Название документа\n- Название задачи\n- ФИО исполнителя\n- Должность исполнителя;

endswitch

if (Экспорт отчёта?) then (да)
    :Сохранение в файл;
else (нет)
endif

stop

@enduml
