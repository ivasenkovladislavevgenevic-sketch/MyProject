@startuml "Use Case Diagram - АИС Делопроизводство"

left to right direction
skinparam packageStyle rectangle

actor "Делопроизводитель\n(Clerk)" as Clerk
actor "Руководитель\n(Manager)" as Manager
actor "Контролёр\n(Controller)" as ControllerActor

rectangle "АИС «Делопроизводство»" {
    usecase "UC1: Регистрация\nдокумента" as UC1
    usecase "UC2: Изменение\nпоручения" as UC2
    usecase "UC2.1: Перенос\nсрока исполнения" as UC2_1
    usecase "UC2.2: Назначение\nнового исполнителя" as UC2_2
    usecase "UC3: Отчёт по\nпросроченным документам" as UC3
    usecase "UC4: Уведомления о\nприближающихся сроках" as UC4
    usecase "UC5: Управление\nкорреспондентами" as UC5
    usecase "UC6: Управление\nсотрудниками" as UC6
}

Clerk --> UC1
Clerk --> UC2
Clerk --> UC5
Clerk --> UC6

Manager --> UC3
Manager --> UC4

ControllerActor --> UC3
ControllerActor --> UC4

UC2 ..> UC2_1 : <<include>>
UC2 ..> UC2_2 : <<include>>

@enduml
