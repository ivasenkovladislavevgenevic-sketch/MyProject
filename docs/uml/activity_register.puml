    :Создание нового корреспондента;
    if (Тип корреспондента?) then (внутренний)
        :Указать отдел и должностное лицо;
    else (внешний)
        :Указать код и название организации;
    endif
endif

:Выбор автора резолюции (сотрудник);
:Выбор контролёра (сотрудник);

:Ввод задач документа;

repeat
    :Указать код и название задачи;
    :Указать срок исполнения;
    :Назначить исполнителя (сотрудник);
repeat while (Ещё задачи?) is (да) not (нет)

:Валидация данных;

if (Данные корректны?) then (да)
    :Сохранение документа в БД;
    :Сохранение задач в БД;
    :Присвоение регистрационной даты;
    :Подтверждение регистрации;
